# -----------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Start with paper/testnet keys only. Disable withdrawals on every API key.
# -----------------------------------------------------------------------------

# Alpaca (US stocks, paper)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Crypto exchange (use testnet/sandbox first)
CRYPTO_EXCHANGE=kraken
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
CRYPTO_PASSPHRASE=
CRYPTO_SANDBOX=true

# Macro
FRED_API_KEY=

# Optional data providers
TIINGO_API_KEY=
EODHD_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
MASSIVE_API_KEY=
DATABENTO_API_KEY=

# Optional social/news
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tradingbot-research/0.1
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Optional AI decision providers
# Jev / TypeSafe typed decisions (hosted, paid, optional)
TYPESAFE_API_KEY=
# OpenAI-compatible local endpoint (Ollama, LM Studio, vLLM) or hosted API
AI_BASE_URL=http://localhost:11434/v1/chat/completions
AI_MODEL=qwen2.5:7b
AI_API_KEY=
# Optional hosted LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Ops
# Optional password for a hosted read-only dashboard.
DASHBOARD_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
TIMEZONE=UTC

# Safety
DRY_RUN=true
MAX_GROSS_EXPOSURE=1.0
MAX_DRAWDOWN_PCT=20
KILL_SWITCH_FILE=artifacts/KILL
